{
  "name": "nexa-stellar",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy:testnet": "node scripts/deploy.mjs --network testnet",
    "deploy:milestone": "node scripts/deploy-milestone.mjs --network testnet",
    "deploy:mainnet": "node scripts/deploy.mjs --network mainnet",
    "contract:build": "cd contracts/crowdfunding && stellar contract build",
    "contract:build:milestone": "cd contracts/milestone && stellar contract build",
    "contract:test": "cd contracts/crowdfunding && cargo test --features testutils",
    "contract:test:milestone": "cd contracts/milestone && cargo test --features testutils",
    "contract:test:all": "npm run contract:test && npm run contract:test:milestone"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^0.9.2",
    "@stellar/stellar-sdk": "14.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "@stellar/stellar-base": "14.1.0"
  }
}